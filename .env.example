# Public browser configuration. These values are embedded in the built frontend; never put secrets here.
# Required: Robinhood Chain mainnet RPC endpoint (public or provider URL, HTTPS).
VITE_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
# Required: explicit network selection. Mainnet is 4663; app rejects other IDs.
VITE_CHAIN_ID=4663
# Required: verify against organizer source and mainnet bytecode before any wallet signature.
VITE_WIF_ADDRESS=0x5173b8ea6923c2d40267890d45c46a3480954773
# Required: get actual runtime code from chain 4663, hash it, and independently compare it with verified source.
VITE_WIF_CODE_HASH=
# Required only after Daymark has been reviewed and deployed on chain 4663. Do not guess this value.
VITE_DAYMARK_ADDRESS=
# Required: hash the deployed runtime bytecode after immutable constructor values are embedded.
VITE_DAYMARK_CODE_HASH=
# Required: public explorer base URL, e.g. official Robinhood Chain explorer.
VITE_EXPLORER_URL=https://robinhoodchain.blockscout.com

# Deployment settings. FOUNDRY_ACCOUNT is an alias in your local Foundry keystore, not a private key.
# Required for deployment only: set to the verified WIF address after checking it on chain 4663.
WIF_TOKEN_ADDRESS=0x5173b8ea6923c2d40267890d45c46a3480954773
# Required for deployment only: public Robinhood Chain mainnet RPC URL.
WIF_RPC_URL=https://rpc.mainnet.chain.robinhood.com/
# Required for deployment only: existing Foundry keystore account name and public signer address.
FOUNDRY_ACCOUNT=
DEPLOYER_ADDRESS=
